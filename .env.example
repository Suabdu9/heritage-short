# Copy to .env and fill in. .env is git-ignored; never commit keys.
# Gemini (Google AI Studio -> Get API key). Used for the script check and the fallback/comparison TTS.
GEMINI_API_KEY=
# Optional overrides if model names move (the pipeline also auto-discovers by listing models):
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Cloudflare Workers AI (dash.cloudflare.com -> AI -> Workers AI -> Use REST API).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Addis Assistant (addisassistant.com -> API keys). Amharic narration.
ADDIS_API_KEY=

# Kaggle (kaggle.com -> Settings -> API -> Create New Token). For Wan 2.2 and ACE-Step on a T4.
# New tokens start with KGAT_: put them here (no username needed)
KAGGLE_API_TOKEN=
# Old-style kaggle.json keys instead:
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional list-price assumptions used in runs.jsonl / COSTS.md
# PRICE_T4_HOUR=0.35
# ETB_PER_USD=155
