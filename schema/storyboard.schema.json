{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/heritage-short/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes only its own outputs.",
  "type": "object",
  "required": ["version", "title", "logline", "audience", "intent", "language", "style", "characters", "models", "narration", "music", "end_card", "shots"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "title_native": {"type": "string"},
    "logline": {"type": "string", "minLength": 10},
    "audience": {"type": "string", "minLength": 10},
    "intent": {"type": "string", "minLength": 10},
    "language": {"type": "string", "description": "ISO 639 code of the narration language, e.g. am", "pattern": "^[a-z]{2,3}$"},
    "narration_review": {
      "type": "object",
      "description": "A native speaker approves the narration text before any line is voiced",
      "required": ["approved"],
      "additionalProperties": false,
      "properties": {"approved": {"type": "boolean"}, "by": {"type": "string"}, "date": {"type": "string"}, "notes": {"type": "string"}}
    },
    "draft": {"type": "boolean", "description": "true = 480p drafts and cheaper settings everywhere"},
    "style": {
      "type": "object",
      "required": ["block"],
      "additionalProperties": false,
      "properties": {
        "block": {"type": "string", "minLength": 10, "description": "Appended to every image prompt"},
        "negative": {"type": "string"}
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "real_person"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string"},
          "description": {"type": "string", "minLength": 10, "description": "Fixed wording reused in every prompt that shows this character"},
          "real_person": {"type": "boolean"},
          "consent_id": {"type": "string", "description": "Key into consent.json; required when real_person is true"},
          "sheet_seed": {"type": "integer"}
        },
        "if": {"properties": {"real_person": {"const": true}}},
        "then": {"required": ["consent_id"]}
      }
    },
    "models": {
      "type": "object",
      "required": ["image", "tts", "video", "music"],
      "additionalProperties": false,
      "properties": {
        "image": {"type": "object", "required": ["provider", "model"], "properties": {"provider": {"enum": ["cloudflare"]}, "model": {"type": "string"}, "fallback_model": {"type": "string"}, "steps": {"type": "integer", "minimum": 1, "maximum": 50}, "width": {"type": "integer"}, "height": {"type": "integer"}}},
        "tts": {"type": "object", "required": ["provider", "voice"], "properties": {"provider": {"enum": ["addis", "gemini"]}, "voice": {"type": "string"}, "fallback_provider": {"enum": ["addis", "gemini", "none"]}, "fallback_voice": {"type": "string"}, "style_prompt": {"type": "string"}, "speed": {"type": "number"}}},
        "video": {"type": "object", "required": ["provider", "model"], "properties": {"provider": {"enum": ["kaggle", "kenburns"]}, "model": {"type": "string"}, "draft_size": {"type": "string"}, "final_size": {"type": "string"}, "steps": {"type": "integer"}, "frames": {"type": "integer"}}},
        "music": {"type": "object", "required": ["provider", "model"], "properties": {"provider": {"enum": ["kaggle", "placeholder"]}, "model": {"type": "string"}, "candidates": {"type": "integer", "minimum": 1, "maximum": 8}, "chosen": {"type": "integer", "minimum": 0}}},
        "text": {"type": "object", "properties": {"model": {"type": "string"}}}
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead_in_s": {"type": "number", "minimum": 0},
        "tail_s": {"type": "number", "minimum": 0},
        "gap_s": {"type": "number", "minimum": 0}
      }
    },
    "music": {
      "type": "object",
      "required": ["caption", "duration_s", "cues"],
      "additionalProperties": false,
      "properties": {
        "caption": {"type": "string", "minLength": 10},
        "bpm": {"type": "integer", "minimum": 40, "maximum": 200},
        "key": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 30, "maximum": 180},
        "seed": {"type": "integer"},
        "duck": {"type": "object", "properties": {"threshold": {"type": "number"}, "ratio": {"type": "number"}, "attack_ms": {"type": "number"}, "release_ms": {"type": "number"}, "music_gain_db": {"type": "number"}}},
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object", "required": ["at_shot", "description"], "properties": {"at_shot": {"type": "string"}, "description": {"type": "string"}}}
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": ["text", "duration_s"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 5},
        "subtext": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 2, "maximum": 6}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "reason", "shot_size", "duration_s", "image_prompt", "motion_prompt", "narration", "subtitle_en", "seed"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "beat": {"type": "string"},
          "reason": {"type": "string", "minLength": 10, "description": "Why this shot exists, in one sentence"},
          "shot_size": {"enum": ["extreme_wide", "wide", "medium", "medium_close", "close", "extreme_close", "insert"]},
          "duration_s": {"type": "number", "minimum": 3, "maximum": 12, "description": "Minimum on-screen time; stretched if the narration is longer"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "image_prompt": {"type": "string", "minLength": 10},
          "motion_prompt": {"type": "string", "minLength": 5},
          "kenburns": {"type": "object", "properties": {"zoom_from": {"type": "number"}, "zoom_to": {"type": "number"}, "pan": {"enum": ["none", "left", "right", "up", "down"]}}},
          "narration": {"type": "string", "description": "Narration line in the film's language; empty string = no voice on this shot"},
          "subtitle_en": {"type": "string"},
          "seed": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
